# Backend & API
APP_BACKEND_URL=http://localhost:8080
APP_FRONTEND_URL=http://localhost
APP_CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:80,http://localhost:4200,http://localhost:5173,http://localhost:5174

# Frontend Config
ITE_API_BASE_URL=http://localhost:8080/api
VITE_IMAGE_BASE_URL=http://localhost:8080/api/images/
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_key_here

# PostgreSQL Database
POSTGRES_USER=zebrakuser
POSTGRES_PASSWORD=your_secure_password
POSTGRES_DB=zebrakdb

# Spring Datasource
SPRING_DATASOURCE_USERNAME=zebrakuser
SPRING_DATASOURCE_PASSWORD=your_secure_password

# Flyway Migration
SPRING_FLYWAY_ENABLED=false
SPRING_FLYWAY_USER=zebrakuser
SPRING_FLYWAY_PASSWORD=your_secure_password

# Redis
REDIS_HOST=localhost
SPRING_DATA_REDIS_HOST=redis

# Security & JWT
JWT_SECRET=your_base64_encoded_256_bit_secret_key_here
APP_SECURITY_COOKIE_NAME=accessToken
