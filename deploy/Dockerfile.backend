# Multi-stage build pro Spring Boot s Java 25
FROM eclipse-temurin:25-jdk-alpine AS build
WORKDIR /app
COPY pom.xml mvnw ./
COPY .mvn .mvn
RUN chmod +x ./mvnw && ./mvnw dependency:go-offline -B || true
COPY src src
RUN ./mvnw clean package -DskipTests

FROM eclipse-temurin:25-jre-alpine
WORKDIR /app

# Vytvoření uživatele s omezenými právy, aby kontejner neběžel jako 'root'
RUN addgroup -S appgroup && adduser -S appuser -G appgroup && mkdir -p /app/uploads && chown -R appuser:appgroup /app

COPY --from=build --chown=appuser:appgroup /app/target/*.jar app.jar
EXPOSE 8080

# Přepnutí na non-root uživatele (bezpečnostní doporučení)
USER appuser

ENTRYPOINT ["java", "-jar", "app.jar"]
