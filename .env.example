# =============================================================================
# VZOROVÁ KONFIGURACE PROSTŘEDÍ PRO APLIKACI ŽEBRÁK
# Zkopírujte tento soubor jako .env a upravte hodnoty dle potřeby.
# =============================================================================

# --- PostgreSQL Databáze ---
POSTGRES_DB=zebrakdb
POSTGRES_USER=zebrakuser
POSTGRES_PASSWORD=zebrakpassword

# --- Spring Boot Datasource (pro lokální běh bez docker sítě) ---
DB_URL=jdbc:postgresql://localhost:5432/zebrakdb
DB_USERNAME=zebrakuser
DB_PASSWORD=zebrakpassword

# --- Redis (pro Blacklist JWT tokenů při odhlášení) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Bezpečnost a JWT ---
# Tajný klíč pro podepisování JWT tokenů (minimálně 256 bitů / 32+ znaků)
JWT_SECRET=superTajnyKlicProVyvojKteryMaAlespon32Znaku123456
JWT_EXPIRATION_MS=86400000

# --- Nahrávání souborů a CORS ---
UPLOAD_DIR=uploads
CORS_ORIGINS=http://localhost,http://localhost:4200,http://localhost:80,http://127.0.0.1:4200

# --- Rate Limiting ---
RATE_LIMIT_PLACE_MIN_INTERVAL=5
RATE_LIMIT_PLACE_MAX_PER_MINUTE=5
DOCKER_COMPOSE_ENABLED=false
