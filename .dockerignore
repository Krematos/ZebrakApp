# =============================================================================
# Root .dockerignore
# =============================================================================

# Version control
.git
.gitignore
.gitattributes

# Environment and sensitive files
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx

# IDEs and editors
.idea/
.vscode/
*.iml
*.iws
*.ipr
.settings/
.project
.classpath
*.sublime-workspace
*.sublime-project
*.swp
*.swo
*~

# Operating System files
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Backend artifacts (Java / Maven)
**/target/
**/*.class
**/*.jar
!**/*.jar.original
**/*.war
**/*.ear
.mvn/wrapper/maven-wrapper.jar
hs_err_pid*
replay_pid*

# Frontend artifacts (Node / Angular)
**/node_modules/
**/dist/
**/.angular/
**/coverage/
**/.sass-cache/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Uploads, database and runtime data
**/uploads/
**/data/
**/pgdata/
**/postgres_data/

# Logs
*.log
logs/
**/logs/

# Documentation & Markdown
*.md
!README.md

# -----------------------------------------------------------------------------
# Documentation (Internal docs)
# -----------------------------------------------------------------------------
doc/
**/doc/
docs/
**/docs/
.doc/
**/.doc/
*.doc
*.docx