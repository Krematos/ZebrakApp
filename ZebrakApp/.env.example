# =============================================================================
# ZebrakApp - Backend Environment Variables Example
# Copy this file to .env or configure in your IDE Run Configuration / OS Environment
# =============================================================================

# Database configuration
DB_URL=jdbc:postgresql://localhost:5432/mydatabase
DB_USERNAME=myuser
DB_PASSWORD=secret

# JWT Secret - Base64 encoded 256-bit (32 bytes) key.
# Generate a new random secret using:
#   Linux/macOS/Git Bash: openssl rand -base64 32
#   PowerShell: [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Minimum 0 -Maximum 256 } | ForEach-Object { [byte]$_ }))
JWT_SECRET=dGVzdFNlY3JldEtleUZvclplYnJha0FwcFRlc3RpbmdPbmx5TmVlZHNUb0JlQXRMZWFzdDI1NkJpdHNMb25nMTIzNDU2Nzg5MA==
JWT_EXPIRATION_MS=86400000

# File Uploads Directory
UPLOAD_DIR=uploads

# CORS Allowed Origins
CORS_ORIGINS=http://localhost,http://localhost:4200,http://localhost:80,http://127.0.0.1:4200

# Spring Docker Compose (optional auto-start for dev)
DOCKER_COMPOSE_ENABLED=false
