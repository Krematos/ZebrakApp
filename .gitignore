# =============================================================================
# Root .gitignore for ŽEBRÁK project (Spring Boot backend + Angular frontend)
# =============================================================================

# -----------------------------------------------------------------------------
# Environment and Secret Files
# -----------------------------------------------------------------------------
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example
!.env.template
*.pem
*.key
*.p12
*.pfx

# -----------------------------------------------------------------------------
# Java & Maven (Backend - ZebrakApp)
# -----------------------------------------------------------------------------
target/
**/target/
*.class
*.jar
*.war
*.ear
*.nar
.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/
hs_err_pid*
replay_pid*

# -----------------------------------------------------------------------------
# Node & Angular (Frontend)
# -----------------------------------------------------------------------------
node_modules/
**/node_modules/
dist/
**/dist/
.angular/
**/.angular/
.sass-cache/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
coverage/
/out-tsc
/bazel-out
.connect.lock
/typings
__screenshots__/

# -----------------------------------------------------------------------------
# Runtime Data & Uploads
# -----------------------------------------------------------------------------
uploads/
**/uploads/
!**/src/**/uploads/
data/
pgdata/
postgres_data/

# -----------------------------------------------------------------------------
# IDEs and Editors
# -----------------------------------------------------------------------------
# IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr
out/

# Eclipse / STS
.apt_generated
.classpath
.factorypath
.project
.settings/
.springBeans
.sts4-cache/

# Visual Studio Code
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.history/

# NetBeans
/nbproject/private/
/nbbuild/
/nbdist/
/.nb-gradle/

# Generic Editors
*.sublime-workspace
*.sublime-project
*.swp
*.swo
*~

# -----------------------------------------------------------------------------
# Operating System Files
# -----------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
ehthumbs_vista.db
Thumbs.db
Thumbs.db:encryptable
Desktop.ini
$RECYCLE.BIN/

# -----------------------------------------------------------------------------
# Log files
# -----------------------------------------------------------------------------
*.log
logs/
**/logs/
